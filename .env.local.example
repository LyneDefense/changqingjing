POSTGRES_DB=changqingjing
POSTGRES_USER=changqingjing
POSTGRES_PASSWORD=changqingjing-local
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/changqingjing
DB_USERNAME=changqingjing
DB_PASSWORD=changqingjing-local

# 仅首次创建后台管理员时临时启用；登录名使用 3-100 位字母、数字、点、下划线或连字符。
# 密码使用 12-128 位且同时包含字母和数字。创建成功后立即恢复为 false 并删除密码值。
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN_NAME=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# N5 COS 联调时启用。只在未提交的本地环境文件中填写开发桶与服务端凭据。
COS_ENABLED=false
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_OBJECT_PREFIX=dev

# N6 后台地图选点。Key 是腾讯位置服务浏览器端 Key，Referer 必须与控制台应用名称一致。
VITE_TENCENT_MAP_KEY=
VITE_TENCENT_MAP_REFERER=changqingjing-admin
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=209715200

# N7 微信手机号登录。AppSecret 只放后端本地环境，绝不能写入小程序代码。
# 加密密钥需为 Base64 编码的 32 字节随机值；一旦产生真实用户数据便不可随意更换。
WECHAT_ENABLED=false
WECHAT_MOCK_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
APP_PHONE_ENCRYPTION_KEY_BASE64=
APP_SESSION_TTL=7d
