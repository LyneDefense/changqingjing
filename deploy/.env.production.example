# 复制为 .env.production，填入真实值后执行：chmod 600 deploy/.env.production
# 值包含空格、#、$ 等 shell 特殊字符时，请使用单引号包住整个值。

# 域名必须已有 A 记录指向此公网 IPv4；不要填写 http:// 或路径。
DOMAIN=CHANGE_ME.example.com
SERVER_PUBLIC_IP=CHANGE_ME
CERTBOT_EMAIL=CHANGE_ME@example.com
CERTBOT_STAGING=false

POSTGRES_DB=changqingjing
POSTGRES_USER=changqingjing
POSTGRES_PASSWORD=CHANGE_ME_AT_LEAST_20_RANDOM_CHARACTERS
BACKUP_RETENTION_DAYS=14

# 每次发布使用新的明确版本标签，禁止 latest。
BACKEND_IMAGE=changqingjing-backend:CHANGE_ME_VERSION
WEB_IMAGE=changqingjing-web:CHANGE_ME_VERSION
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8'

WECHAT_APP_ID=CHANGE_ME
WECHAT_APP_SECRET=CHANGE_ME
APP_PHONE_ENCRYPTION_KEY_BASE64=CHANGE_ME_BASE64_32_BYTES
APP_SESSION_TTL=7d

COS_BUCKET=CHANGE_ME
COS_REGION=CHANGE_ME
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COS_OBJECT_PREFIX=prod

# 腾讯位置服务 WebService/选点器的浏览器端 Key 与控制台 Referer 名称。
VITE_TENCENT_MAP_KEY=CHANGE_ME
VITE_TENCENT_MAP_REFERER=CHANGE_ME

# 仅首次创建管理员时设 true。成功登录后改回 false，并清空下方三项。
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_LOGIN_NAME=CHANGE_ME
ADMIN_BOOTSTRAP_DISPLAY_NAME=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_LETTERS_AND_DIGITS

RATE_LIMIT_APP_AUTH_PER_MINUTE=30
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=30
RATE_LIMIT_MEDIA_UPLOAD_PER_MINUTE=60
RATE_LIMIT_SCENIC_VIEW_PER_MINUTE=120
